GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Chemin absolu vers le projet à modifier (optionnel, défaut: ./target-project)
TARGET_PROJECT_DIR=

# Port du backend FastAPI (optionnel, défaut: 8000)
WS_PORT=8000

# Timeout max pour Claude Code en secondes (optionnel, défaut: 120)
CLAUDE_TIMEOUT=120
